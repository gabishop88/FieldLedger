{
  "python.venvFolders": [
    "backend/.venv"
  ],
  "python.venvPath": "${workspaceFolder}/backend",
  "python.defaultInterpreterPath": "backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "backend"
  ],
  "material-icon-theme.folders.associations": {
    "crud": "resource",
    "versions": "update",
    ".uv": "packages",
    "db-init": "database"
  },
  "python.testing.pytestArgs": [
    "backend"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.exclude": {
    "**/.uv": true,
    "**/.venv": true,
    "**/.coverage": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
  },
  "editor.fontFamily": "Monaspace Krypton Var",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05'",
  "editor.inlineSuggest.fontFamily": "Monaspace Neon Var",
  "editor.inlayHints.fontFamily": "Monaspace Radon Var",
  "[python]": {
    "editor.rulers": [88]
  }
}
# syntax=docker/dockerfile:1
FROM python:3.12-slim
# This draws heavily from https://github.com/fastapi/full-stack-fastapi-template

# NOTE: Used primarily for pg_dump and pg_restore
# Add PGDG apt repo for PostgreSQL 18 client tools
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg ca-certificates && \
    wget --quiet -O /usr/share/keyrings/postgresql-archive-keyring.gpg \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc && \
    echo "deb [signed-by=/usr/share/keyrings/postgresql-archive-keyring.gpg] https://apt.postgresql.org/pub/repos/apt/ $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client-18 && \
    rm -rf /var/lib/apt/lists/*


# See: https://docs.astral.sh/uv/guides/integration/docker/#using-the-environment
# See: https://docs.astral.sh/uv/guides/integration/docker/#compiling-bytecode
# See: https://docs.astral.sh/uv/guides/integration/docker/#caching
# PYTHONUNBUFFERED=1 Flushes log buffers immediately for better/more immediate logging
# PYTHONDONTWRITEBYTECODE=1 prevents backend:dev services from generating __pycache__ files owned by root.
# PYTHONPATH=/app tells python to look in /app when importing, which is where the project files are being mounted.
# PATH="/app/.venv/bin:$PATH" adds the venv generated by uv to the path (which means python and other commands are run in that environment)
# UV_COMPILE_BYTECODE=1 slightly speeds up build time by generating __pycache__ only within .venv, which keeps it away from shared folders
# UV_LINK_MODE=copy makes uv always copy installed packages between caches, which sacrifies space for reliability.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH" \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app/

# Install uv https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/

# Install Python dependencies (only deps here)
# See: https://docs.astral.sh/uv/guides/integration/docker/#intermediate-layers
COPY pyproject.toml uv.lock /app/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

# Copy over app code
COPY ./app /app/app

# Sync with project installed
# Purpose: resolve and cache outside dependencies before project code is added.
# A change to project code can use cached outside dependencies and rebuild project dependencies.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync 

# Default command for production
CMD ["fastapi", "run", "--workers", "4", "app/main.py"]
